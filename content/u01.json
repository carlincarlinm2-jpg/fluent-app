        {"en": "good night", "es": "buenas noches (al despedirse)", "pos": "phrase", "ex_en": "Good night, Mom.", "ex_es": "Buenas noches, mamá."},
        {"en": "see you later", "es": "nos vemos luego", "pos": "phrase", "ex_en": "Bye, Tom. See you later!", "ex_es": "Adiós, Tom. ¡Nos vemos luego!"}
