        {"en": "you're welcome", "es": "de nada", "pos": "phrase", "ex_en": "You're welcome, Luis.", "ex_es": "De nada, Luis."},
        {"en": "excuse me", "es": "disculpe, con permiso", "pos": "phrase", "ex_en": "Excuse me, what's your name?", "ex_es": "Disculpe, ¿cómo se llama?"},
        {"en": "sorry", "es": "perdón, lo siento", "pos": "interj", "ex_en": "Sorry, Emma!", "ex_es": "¡Perdón, Emma!"},
        {"en": "no problem", "es": "no hay problema", "pos": "phrase", "ex_en": "No problem, Carlos.", "ex_es": "No hay problema, Carlos."},
        {"en": "of course", "es": "claro, por supuesto", "pos": "phrase", "ex_en": "Of course, Sara.", "ex_es": "Claro, Sara."}
      ],
      "sentences": [
        {"en": "Thank you very much, Emma!", "es": "¡Muchas gracias, Emma!"},
        {"en": "Excuse me, how do you spell it?", "es": "Disculpe, ¿cómo se escribe?"},
        {"en": "Sorry, repeat it slowly, please.", "es": "Perdón, repítalo despacio, por favor."},
        {"en": "No problem. You're welcome.", "es": "No hay problema. De nada."},
        {"en": "Thanks, Carlos. See you later!", "es": "Gracias, Carlos. ¡Nos vemos luego!"}
      ],
      "tip_es": "Usa excuse me antes de interrumpir o pedir algo, como disculpe. Usa sorry después de un error, como perdón. Si no escuchaste bien, di Sorry? con tono de pregunta."
    },
