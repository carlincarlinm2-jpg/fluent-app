        {"en": "Are you sick? No, I'm fine.", "es": "¿Estás enfermo? No, estoy bien."},
        {"en": "Sorry, I'm very busy.", "es": "Perdón, estoy muy ocupada."},
        {"en": "I'm hungry and thirsty. And you?", "es": "Tengo hambre y sed. ¿Y tú?"}
