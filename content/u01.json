  "dialogue": {
    "title_es": "El primer día de clase",
    "setting_es": "Es tu primer día en la clase de inglés y una compañera te saluda.",
    "lines": [
      {"who": "A", "en": "Hi! Good morning. I'm Emma.", "es": "¡Hola! Buenos días. Soy Emma."},
      {"who": "B", "en": "Hello, Emma. My name is Carlos.", "es": "Hola, Emma. Me llamo Carlos."},
      {"who": "A", "en": "Nice to meet you, Carlos. How are you?", "es": "Mucho gusto, Carlos. ¿Cómo estás?"},
      {"who": "B", "en": "I'm fine, thanks. And you?", "es": "Estoy bien, gracias. ¿Y tú?"},
      {"who": "A", "en": "I'm great! What's your last name?", "es": "¡Muy bien! ¿Cuál es tu apellido?"},
      {"who": "B", "en": "Ruiz. R, U, I, Z.", "es": "Ruiz. R, U, I, Z."},
      {"who": "A", "en": "Sorry? Spell it slowly, please.", "es": "¿Perdón? Deletréalo despacio, por favor."},
      {"who": "B", "en": "Of course. R, U, I, Z.", "es": "Claro. R, U, I, Z."},
      {"who": "A", "en": "Thank you! Are you a student?", "es": "¡Gracias! ¿Eres estudiante?"},
      {"who": "B", "en": "Yes, I am. See you later, Emma!", "es": "Sí. ¡Nos vemos luego, Emma!"}
