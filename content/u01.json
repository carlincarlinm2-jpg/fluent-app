        {"en": "good", "es": "bien, bueno", "pos": "adj", "ex_en": "I'm good. And you?", "ex_es": "Estoy bien. ¿Y tú?"},
        {"en": "great", "es": "muy bien, excelente", "pos": "adj", "ex_en": "I'm great!", "ex_es": "¡Estoy muy bien!"},
        {"en": "okay", "es": "bien, normal", "pos": "adj", "ex_en": "I'm okay.", "ex_es": "Estoy bien, normal."},
        {"en": "not bad", "es": "nada mal", "pos": "phrase", "ex_en": "Not bad. And you?", "ex_es": "Nada mal. ¿Y tú?"},
        {"en": "tired", "es": "cansado, cansada", "pos": "adj", "ex_en": "I'm tired.", "ex_es": "Estoy cansado."},
        {"en": "very", "es": "muy", "pos": "adv", "ex_en": "I'm very tired.", "ex_es": "Estoy muy cansada."}
      ],
      "sentences": [
        {"en": "Good morning! How are you?", "es": "¡Buenos días! ¿Cómo estás?"},
        {"en": "I'm fine. And you?", "es": "Estoy bien. ¿Y tú?"},
        {"en": "I'm great, Luis!", "es": "¡Estoy muy bien, Luis!"},
        {"en": "Not bad. I'm very tired.", "es": "Nada mal. Estoy muy cansado."},
        {"en": "Hi, Tom! I'm good. How are you?", "es": "¡Hola, Tom! Estoy bien. ¿Cómo estás?"}
      ],
      "tip_es": "I'm sirve para soy y para estoy: I'm Ana (soy Ana), I'm tired (estoy cansada). Los adjetivos en inglés no cambian por género, así que tired es igual para hombre o mujer."
    },
    {
      "id": "1-4",
      "title_es": "El alfabeto y deletrear",
      "words": [
        {"en": "letter", "es": "letra", "pos": "noun", "ex_en": "What letter is it?", "ex_es": "¿Qué letra es?"},
        {"en": "alphabet", "es": "abecedario, alfabeto", "pos": "noun", "ex_en": "The English alphabet has 26 letters.", "ex_es": "El alfabeto inglés tiene 26 letras."},
        {"en": "spell", "es": "deletrear", "pos": "verb", "ex_en": "How do you spell it?", "ex_es": "¿Cómo se escribe?"},
        {"en": "first name", "es": "nombre (de pila)", "pos": "phrase", "ex_en": "My first name is Laura.", "ex_es": "Mi nombre es Laura."},
        {"en": "last name", "es": "apellido", "pos": "phrase", "ex_en": "My last name is Ruiz.", "ex_es": "Mi apellido es Ruiz."},
        {"en": "again", "es": "otra vez, de nuevo", "pos": "adv", "ex_en": "Spell it again.", "ex_es": "Deletréalo otra vez."},
        {"en": "slowly", "es": "despacio", "pos": "adv", "ex_en": "Spell your name slowly.", "ex_es": "Deletrea tu nombre despacio."},
        {"en": "repeat", "es": "repetir", "pos": "verb", "ex_en": "Repeat the letter.", "ex_es": "Repite la letra."}
      ],
      "sentences": [
        {"en": "What's your last name?", "es": "¿Cuál es tu apellido?"},
        {"en": "My last name is Ruiz. R, U, I, Z.", "es": "Mi apellido es Ruiz. R, U, I, Z."},
        {"en": "How do you spell your first name?", "es": "¿Cómo se escribe tu nombre?"},
        {"en": "Is it B or V?", "es": "¿Es B o V?"},
        {"en": "Repeat it again slowly.", "es": "Repítelo otra vez, despacio."}
      ],
      "tip_es": "Ojo con las vocales: en inglés la A se dice ei, la E se dice i y la I se dice ai. Son las letras que más confunden al deletrear, así que practica tu nombre con ellas."
    },
    {
      "id": "1-5",
      "title_es": "Por favor y gracias",
