      "sentences": [
        {"en": "How old are you? I'm nineteen.", "es": "¿Cuántos años tienes? Tengo diecinueve."},
        {"en": "She's twenty-four years old.", "es": "Ella tiene veinticuatro años."},
        {"en": "What's your cell phone number?", "es": "¿Cuál es tu número de celular?"},
