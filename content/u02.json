      "sentences": [
        {"en": "Twenty-one, twenty-two, twenty-three.", "es": "Veintiuno, veintidós, veintitrés."},
        {"en": "Is it forty or fourteen?", "es": "¿Es cuarenta o catorce?"},
        {"en": "Mr. Brown is fifty-five.", "es": "El señor Brown tiene cincuenta y cinco años."},
        {"en": "I'm thirty-seven. And you?", "es": "Tengo treinta y siete años. ¿Y tú?"},
