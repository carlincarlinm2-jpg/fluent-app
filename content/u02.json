  "dialogue": {
    "title_es": "Inscripción en el gimnasio",
    "setting_es": "Te inscribes en un gimnasio y la recepcionista te pide tus datos.",
    "lines": [
      {"who": "A", "en": "Hi! What's your name, please?", "es": "¡Hola! ¿Cómo te llamas, por favor?"},
      {"who": "B", "en": "My name is Laura Ortiz.", "es": "Me llamo Laura Ortiz."},
      {"who": "A", "en": "Nice to meet you. How old are you?", "es": "Mucho gusto. ¿Cuántos años tienes?"},
      {"who": "B", "en": "I'm twenty-eight years old.", "es": "Tengo veintiocho años."},
      {"who": "A", "en": "Great. Where are you from?", "es": "Muy bien. ¿De dónde eres?"},
      {"who": "B", "en": "I'm from Mexico, from Puebla.", "es": "Soy de México, de Puebla."},
      {"who": "A", "en": "What's your phone number?", "es": "¿Cuál es tu número de teléfono?"},
      {"who": "B", "en": "It's five, five, five, zero, one, four, nine.", "es": "Es cinco, cinco, cinco, cero, uno, cuatro, nueve."},
      {"who": "A", "en": "Thanks. And your email?", "es": "Gracias. ¿Y tu correo?"},
      {"who": "B", "en": "It's laura at fluent dot com.", "es": "Es laura arroba fluent punto com."}
