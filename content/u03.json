  "dialogue": {
    "title_es": "Fotos de familia",
    "setting_es": "Una amiga ve las fotos de tu familia en tu celular.",
    "lines": [
      {"who": "A", "en": "Is this your family?", "es": "¿Es tu familia?"},
      {"who": "B", "en": "Yes! This is my mom, Rosa.", "es": "¡Sí! Ella es mi mamá, Rosa."},
      {"who": "A", "en": "She's very pretty. Who is the tall man?", "es": "Es muy bonita. ¿Quién es el señor alto?"},
      {"who": "B", "en": "That's my brother, Daniel. He's thirty.", "es": "Es mi hermano Daniel. Tiene treinta años."},
      {"who": "A", "en": "He's handsome! Is he nice?", "es": "¡Es guapo! ¿Es buena onda?"},
      {"who": "B", "en": "Yes, he's very funny. He's a teacher.", "es": "Sí, es muy chistoso. Es maestro."},
      {"who": "A", "en": "And the girl with curly hair?", "es": "¿Y la niña de pelo chino?"},
      {"who": "B", "en": "That's Sofia, my brother's daughter.", "es": "Es Sofía, la hija de mi hermano."},
      {"who": "A", "en": "How old is she?", "es": "¿Cuántos años tiene?"},
      {"who": "B", "en": "She's six. She's shy, but very smart.", "es": "Tiene seis años. Es tímida, pero muy inteligente."}
