        {"en": "young", "es": "joven", "pos": "adj", "ex_en": "Her mom is very young.", "ex_es": "Su mamá es muy joven."},
        {"en": "old", "es": "viejo, grande (de edad)", "pos": "adj", "ex_en": "My grandfather is old.", "ex_es": "Mi abuelo ya está grande."},
        {"en": "big", "es": "grande", "pos": "adj", "ex_en": "Our family is big.", "ex_es": "Nuestra familia es grande."},
        {"en": "small", "es": "pequeño, chico", "pos": "adj", "ex_en": "Their baby is small.", "ex_es": "Su bebé es chiquito."},
        {"en": "thin", "es": "delgado, delgada", "pos": "adj", "ex_en": "My uncle is tall and thin.", "ex_es": "Mi tío es alto y delgado."},
        {"en": "strong", "es": "fuerte", "pos": "adj", "ex_en": "My dad is strong.", "ex_es": "Mi papá es fuerte."}
      ],
      "sentences": [
        {"en": "Is your sister tall or short?", "es": "¿Tu hermana es alta o bajita?"},
        {"en": "He's young, but he's very strong.", "es": "Es joven, pero es muy fuerte."},
        {"en": "My parents aren't old.", "es": "Mis papás no están grandes."},
        {"en": "We have a big family.", "es": "Tenemos una familia grande."},
        {"en": "Her cousin is short and thin.", "es": "Su prima es bajita y delgada."}
      ],
      "tip_es": "El adjetivo va antes del sustantivo: a big family es una familia grande. Además, nunca cambia por género ni número: tall sirve para alto, alta, altos y altas."
    },
