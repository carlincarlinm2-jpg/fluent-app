        {"en": "family", "es": "familia", "pos": "noun", "ex_en": "This is my family.", "ex_es": "Esta es mi familia."},
        {"en": "mother", "es": "madre", "pos": "noun", "ex_en": "My mother is fifty.", "ex_es": "Mi madre tiene cincuenta años."},
        {"en": "father", "es": "padre", "pos": "noun", "ex_en": "My father is from Oaxaca.", "ex_es": "Mi padre es de Oaxaca."},
        {"en": "mom", "es": "mamá", "pos": "noun", "ex_en": "Hi, Mom!", "ex_es": "¡Hola, mamá!"},
        {"en": "dad", "es": "papá", "pos": "noun", "ex_en": "Thanks, Dad!", "ex_es": "¡Gracias, papá!"},
        {"en": "brother", "es": "hermano", "pos": "noun", "ex_en": "Luis is my brother.", "ex_es": "Luis es mi hermano."},
        {"en": "sister", "es": "hermana", "pos": "noun", "ex_en": "My sister is a student.", "ex_es": "Mi hermana es estudiante."},
        {"en": "parents", "es": "papás, padres", "pos": "noun", "ex_en": "My parents are sixty.", "ex_es": "Mis papás tienen sesenta años."}
      ],
      "sentences": [
        {"en": "This is my mom, Rosa.", "es": "Ella es mi mamá, Rosa."},
        {"en": "My dad is a teacher.", "es": "Mi papá es maestro."},
        {"en": "Are they your parents?", "es": "¿Son tus papás?"},
        {"en": "My brother is twenty-two.", "es": "Mi hermano tiene veintidós años."},
        {"en": "My sister and I are students.", "es": "Mi hermana y yo somos estudiantes."}
      ],
      "tip_es": "Parents significa papás (mamá y papá juntos), no parientes. Para parientes en general se dice relatives. Es un falso amigo muy común."
    },
    {
      "id": "3-2",
      "title_es": "Hijos, pareja y abuelos",
      "words": [
        {"en": "son", "es": "hijo", "pos": "noun", "ex_en": "My son is a student.", "ex_es": "Mi hijo es estudiante."},
        {"en": "daughter", "es": "hija", "pos": "noun", "ex_en": "My daughter is twelve years old.", "ex_es": "Mi hija tiene doce años."},
        {"en": "husband", "es": "esposo", "pos": "noun", "ex_en": "My husband is from Texas.", "ex_es": "Mi esposo es de Texas."},
        {"en": "wife", "es": "esposa", "pos": "noun", "ex_en": "This is my wife, Laura.", "ex_es": "Ella es mi esposa, Laura."},
        {"en": "grandmother", "es": "abuela", "pos": "noun", "ex_en": "My grandmother is eighty.", "ex_es": "Mi abuela tiene ochenta años."},
        {"en": "grandfather", "es": "abuelo", "pos": "noun", "ex_en": "My grandfather is ninety-one.", "ex_es": "Mi abuelo tiene noventa y un años."},
        {"en": "uncle", "es": "tío", "pos": "noun", "ex_en": "My uncle is American.", "ex_es": "Mi tío es estadounidense."},
        {"en": "aunt", "es": "tía", "pos": "noun", "ex_en": "Aunt Carmen is my mom's sister.", "ex_es": "La tía Carmen es hermana de mi mamá."}
      ],
      "sentences": [
        {"en": "Is he your son?", "es": "¿Es tu hijo?"},
        {"en": "My wife and I are from Monterrey.", "es": "Mi esposa y yo somos de Monterrey."},
        {"en": "My grandmother is my dad's mother.", "es": "Mi abuela es la mamá de mi papá."},
        {"en": "My uncle Pedro is my mom's brother.", "es": "Mi tío Pedro es hermano de mi mamá."},
        {"en": "My husband is forty-three years old.", "es": "Mi esposo tiene cuarenta y tres años."}
      ],
      "tip_es": "Para decir de quién es algo se usa 's: my mom's sister es la hermana de mi mamá. El orden es al revés que en español, primero el dueño y luego la cosa. De cariño se dice grandma y grandpa."
    },
    {
      "id": "3-3",
      "title_es": "Su, nuestro y tener",
      "words": [
        {"en": "your", "es": "tu, su (de usted)", "pos": "pron", "ex_en": "Is she your sister?", "ex_es": "¿Ella es tu hermana?"},
        {"en": "his", "es": "su (de él)", "pos": "pron", "ex_en": "His name is Pedro.", "ex_es": "Su nombre es Pedro."},
        {"en": "her", "es": "su (de ella)", "pos": "pron", "ex_en": "Her name is Carmen.", "ex_es": "Su nombre es Carmen."},
        {"en": "our", "es": "nuestro, nuestra", "pos": "pron", "ex_en": "Our mom is a teacher.", "ex_es": "Nuestra mamá es maestra."},
        {"en": "their", "es": "su (de ellos)", "pos": "pron", "ex_en": "Their son is six.", "ex_es": "Su hijo tiene seis años."},
        {"en": "have", "es": "tener", "pos": "verb", "ex_en": "I have two sisters.", "ex_es": "Tengo dos hermanas."},
        {"en": "has", "es": "tiene", "pos": "verb", "ex_en": "She has a son.", "ex_es": "Ella tiene un hijo."},
        {"en": "cousin", "es": "primo, prima", "pos": "noun", "ex_en": "My cousin is from Chicago.", "ex_es": "Mi primo es de Chicago."}
      ],
      "sentences": [
        {"en": "Her brother is my friend.", "es": "Su hermano es mi amigo."},
        {"en": "His wife has two brothers.", "es": "Su esposa tiene dos hermanos."},
        {"en": "We have three cousins.", "es": "Tenemos tres primos."},
        {"en": "Their parents are from Mexico.", "es": "Sus papás son de México."},
        {"en": "What's your cousin's name?", "es": "¿Cómo se llama tu primo?"}
      ],
      "tip_es": "His es su cuando el dueño es hombre y her cuando es mujer: his mom (la mamá de él), her mom (la mamá de ella). Con he, she e it, el verbo have cambia a has."
    },
    {
